{
  "name": "dvs-onboarding-relying-party",
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "build": "sam build --template template.yaml --build-dir build",
    "lint": "prettier  \"*/**/*.{ts,json}\" --check; eslint . ",
    "lint:fix": "prettier  \"*/**/*.{ts,json}\" --write; eslint . --fix",
    "tflint": "tflint --init && tflint --recursive --format compact --chdir infra",
    "tflint:fix": "tflint --init && tflint --recursive --format compact --chdir infra --fix",
    "test:unit": "vitest --run",
    "test:integration": "vitest --run --config=vitest.integration.config.ts",
    "dynamodblocal:up": "docker compose -f docker-compose.local.yml up -d",
    "dynamodblocal:down": "docker compose -f docker-compose.local.yml down",
    "start:local": "sam local start-api --template build/template.yaml --warm-containers EAGER  --env-vars local-env.json"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1133.0",
    "@aws-sdk/client-kms": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1133.0",
    "esbuild": "^0.28.2",
    "jose": "^6.2.13",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.3",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.5"
  }
}
